# Server only. Copy to .env.local. Never commit a real key.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3

# Public demo protection: all are required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact HTTPS origin, no trailing slash.
DEMO_APP_ORIGIN=
# Stable identifier shared by all deployments/replicas; do not rotate to bypass quota.
DEMO_QUOTA_NAMESPACE=matchcart-hackathon-2026
# Optional: enabled for local HTTPS verification of production protection.
DEMO_PROTECTION=
NEXT_PUBLIC_DEMO_PROTECTION=

